{
    "name": "jests-mock-utils",
    "version": "1.0.1",
    "author": "Tom Mitchell",
    "description": "A TypeScript-Jest utility library that simplifies the creation of strongly-typed mocks.",
    "homepage": "https://github.com/tommitchell28/jests-mock-utils",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "Jest",
        "TypeScript",
        "Mocking"
    ],
    "scripts": {
        "build": "tsc",
        "format": "prettier --write .",
        "docs:generate": "typedoc src/index.ts",
        "lint": "eslint .",
        "lint:staged": "lint-staged",
        "prepare": "husky install",
        "prepublishOnly": "npm run build",
        "test": "jest"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@typescript-eslint/eslint-plugin": "8.24.1",
        "@typescript-eslint/parser": "8.24.1",
        "eslint": "^8.52.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-prettier": "^5.0.1",
        "husky": "^8.0.0",
        "jest": "^29.7.0",
        "lint-staged": "^15.0.2",
        "prettier": "3.5.1",
        "ts-jest": "29.2.5",
        "typedoc": "0.27.7",
        "typescript": "5.7.3"
    },
    "lint-staged": {
        "*.ts": "eslint",
        "*": "prettier --write --ignore-unknown"
    }
}
